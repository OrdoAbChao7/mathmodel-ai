# Normalize line endings across platforms so byte-level provenance hashes
# (e.g. G9 source-manifest recomputation) are stable on Windows and Linux CI.
* text=auto eol=lf

# Windows batch scripts require CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary evidence and data formats.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.xls binary
*.doc binary
*.docx binary
*.ttf binary
*.zip binary
*.7z binary
*.rar binary
*.ico binary
